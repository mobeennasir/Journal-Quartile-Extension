{
  "action": {
    "default_icon": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_title": "Journal Quartile Extension"
  },
  "background": {
    "service_worker": "background.js"
  },
  "description": "Look up an article by DOI, article link or manual entry via Crossref (OpenAlex fallback), then show its journal quartile and Impact Factor for the publication year from JCR data you import, with a labelled SJR fallback, WoS category W/X and an HEC fallback. Free WoS, SJR and HEC (DOAJ) data are fetched automatically, once a year, and stored until the next list is published. Batch upload of Excel/CSV article lists with CSV export.",
  "host_permissions": [
    "https://api.crossref.org/*",
    "https://api.openalex.org/*",
    "https://mjl.clarivate.com/*",
    "https://www.scimagojr.com/*",
    "https://scimagojr.com/*",
    "https://doaj.org/*",
    "https://*.nature.com/*",
    "https://nature.com/*",
    "https://*.sciencedirect.com/*",
    "https://sciencedirect.com/*",
    "https://*.elsevier.com/*",
    "https://*.springer.com/*",
    "https://*.link.springer.com/*",
    "https://*.onlinelibrary.wiley.com/*",
    "https://*.tandfonline.com/*",
    "https://*.mdpi.com/*",
    "https://*.frontiersin.org/*",
    "https://*.nih.gov/*",
    "https://*.europepmc.org/*",
    "https://*.oup.com/*",
    "https://*.sagepub.com/*",
    "https://*.cambridge.org/*",
    "https://*.acs.org/*",
    "https://*.rsc.org/*",
    "https://*.iop.org/*",
    "https://*.science.org/*",
    "https://*.cell.com/*",
    "https://*.thelancet.com/*",
    "https://*.bmj.com/*",
    "https://*.plos.org/*",
    "https://*.biorxiv.org/*",
    "https://*.medrxiv.org/*"
  ],
  "icons": {
    "128": "icons/icon128.png",
    "16": "icons/icon16.png",
    "48": "icons/icon48.png"
  },
  "manifest_version": 3,
  "name": "Journal Quartile Extension",
  "author": "Mobeen Nasir",
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "permissions": [
    "storage",
    "activeTab",
    "sidePanel",
    "scripting",
    "tabs"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "version": "0.4.7"
}